# 下文提到的「部署指南」即发布包里的 README.md（源码仓库中为 docs/DEPLOY.md）

# ============ 必填 ============
# 数据库密码（设一个复杂的即可）。注意：只在第一次启动、初始化数据库时生效，之后要改密码请看部署指南「常见问题」
DB_PASSWORD=change-me-to-a-strong-password

# 管理员账号：每次启动时检查，该用户名不存在就按此创建（密码 8–64 位，且不能沿用下面的示例值，否则启动失败）
# 不会修改已有账号的密码；该用户名已被普通用户注册时，只有密码与其一致才会设为管理员。忘记密码见部署指南「常见问题」
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# ============ 常用 ============
# 对外端口。直接用 http://服务器IP:8080 访问时保持默认；
# 启用 HTTPS（内置 Caddy 或已有 Nginx）后改为只监听本机，防止绕过 HTTPS 明文访问：
#   HTTP_PORT=127.0.0.1:8080
HTTP_PORT=8080
# 可信的反向代理：只采信它们转发来的客户端 IP（X-Forwarded-For），用于登录频率限制和日志。
# 留空＝信任本机和内网地址，适用于内置 Caddy / 本机 Nginx；不用反向代理、直接开放 8080 端口时建议填 none，
# 防止伪造 X-Forwarded-For 绕过登录频率限制（之后启用 Caddy / Nginx 时要改回留空）；也可填代理 IP / 网段，逗号分隔
TRUSTED_PROXIES=
# 站点名称：仅作初始值；管理员在后台「站点设置」保存过之后以后台为准，这里再改不生效
SITE_NAME=TripHub

# 国内服务器拉不到 Docker Hub 时，可换成镜像加速地址，例如：
# POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine
POSTGRES_IMAGE=postgres:16-alpine

# JWT 签名密钥，留空会自动生成并保存在 data/app/jwt_secret
JWT_SECRET=

# ============ 高德地图（强烈建议配置） ============
# 高德开放平台 -> 控制台 -> 应用管理 -> 添加 Key，服务平台必须选「Web服务」（选「Web端(JS API)」的 Key 在服务器上用不了）
# 配置后才能搜索具体店铺/景点/民宿、识别街道级地址、推荐附近地点
# 配好后在「管理后台 -> 系统诊断」确认显示「正常」；搜不到店铺时那里会显示原因
AMAP_KEY=

# 天地图（可选，免费）：没有高德 Key、高德出错或搜不到时的备用地点搜索 / 地址识别
# 天地图控制台 https://console.tianditu.gov.cn/ -> 应用管理 -> 创建新应用，应用类型选「服务端」
TIANDITU_KEY=

# ============ AI 推荐 / AI 规划（可选） ============
# 任何 OpenAI 兼容接口都可以（AI_BASE_URL 带不带 /v1 都行）：
#   DeepSeek:   AI_BASE_URL=https://api.deepseek.com             AI_MODEL=deepseek-flash
#   通义千问:    AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  AI_MODEL=qwen-plus
#   Kimi:       AI_BASE_URL=https://api.moonshot.cn/v1           AI_MODEL=moonshot-v1-8k
#   本地 Ollama: AI_BASE_URL=http://host.docker.internal:11434/v1  AI_MODEL=qwen2.5:7b （AI_API_KEY 留空；需先让 Ollama 监听 0.0.0.0，见部署指南「使用本机 Ollama」）
# 配好后在「管理后台 -> 系统诊断」确认显示「正常」
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# AI 规划的超时（秒数或 90s / 5m 这样的时长），留空默认 120 秒；「推荐下一站」最多等 20 秒
# 本地模型（尤其是只有 CPU 的服务器）生成多日行程可能要几分钟，建议 300s；用 Nginx 反代时 proxy_read_timeout 要大于它
AI_TIMEOUT=
# 深度思考：留空或 off＝关闭（快，推荐）；on / low / high / max＝开启（DeepSeek 的思考强度，慢很多，需同时调大 AI_TIMEOUT）
# DeepSeek 默认会开启深度思考，TripHub 默认替你关掉；通义千问同样默认关闭
AI_THINKING=
# 高级：合并到每次 AI 请求中的 JSON 对象（其他服务商的特有参数），如 AI_EXTRA_BODY={"enable_thinking": false}
AI_EXTRA_BODY=

# 单张照片最大 MB。网页端上传前会自动压缩照片，一般 20 就够用
# 内置 Caddy 不另外限制上传大小（自动以此为准）；使用自己的 Nginx 时，client_max_body_size 要大于此值（再多留 1MB）
MAX_UPLOAD_MB=20
# 允许跨域的来源（给 App/其它前端调用时用，逗号分隔）
CORS_ORIGINS=
# 程序的内存软上限（避免 1C2G 小服务器上与 PostgreSQL 抢内存）：留空为 800MiB；内存更大的服务器可调大，如 1500MiB（单位写 MiB 或 GiB）
GOMEMLIMIT=

# ============ HTTPS（可选，使用内置 Caddy 自动申请证书） ============
# 浏览器定位（实时记录轨迹、打卡）必须在 HTTPS 下才能使用
# 启用 HTTPS 时同时把上面的 HTTP_PORT 改为 127.0.0.1:8080（TRUSTED_PROXIES 填过 none 的要改回留空）
# DOMAIN=trip.example.com
# 设置好 DOMAIN 后建议取消下一行注释，之后 docker compose up -d / down（包括升级）会自动带上 Caddy，不用每次加 --profile https
# COMPOSE_PROFILES=https
# CADDY_IMAGE=docker.m.daocloud.io/library/caddy:2-alpine

# ============ 高级：自定义底图瓦片（一般不用改） ============
# 逗号分隔的瓦片 URL 模板，必须是 GCJ-02 坐标系（如高德/腾讯），留空使用高德瓦片
# TILES_NORMAL=
# TILES_SATELLITE=
# TILES_SATELLITE_LABEL=
# 地图右下角显示的底图版权 / 审图号（可含 HTML），留空显示「© 高德地图」；换用其他瓦片时填写对应的版权与审图号
# TILES_ATTRIBUTION=

# ============ 在源码仓库中部署（使用发布包时不用管） ============
# 在仓库的 deploy/ 目录里部署（服务器上从源码编译，不需要发布包）时取消下一行注释
# COMPOSE_FILE=docker-compose.yml:docker-compose.source.yml
# 国内服务器编译时的镜像加速，例如：
# NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
# GO_IMAGE=docker.m.daocloud.io/library/golang:1.27-alpine
# NPM_REGISTRY=https://registry.npmmirror.com
# GOPROXY=https://goproxy.cn,direct
