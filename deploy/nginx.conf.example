# 已有 Nginx 时的反向代理示例（把证书路径和域名换成自己的）
server {
    listen 80;
    server_name trip.example.com;
    return 301 https://$host$request_uri;
}

server {
    # nginx ≥ 1.25.1 会提示该写法已弃用（仅警告，可忽略）；也可改为 "listen 443 ssl;" 并另起一行 "http2 on;"（旧版 nginx 不支持 http2 on）
    listen 443 ssl http2;
    server_name trip.example.com;

    ssl_certificate     /etc/nginx/ssl/trip.example.com.pem;
    ssl_certificate_key /etc/nginx/ssl/trip.example.com.key;

    # HSTS：浏览器记住本站只用 HTTPS 访问，防止在公共 Wi-Fi 下被降级成明文 HTTP
    add_header Strict-Transport-Security "max-age=31536000" always;

    # 需大于 .env 中的 MAX_UPLOAD_MB（再多留 1MB 表单开销），否则超出的上传会被 Nginx 直接拒绝
    client_max_body_size 60m;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location / {
        # 需在 .env 中设置 HTTP_PORT=127.0.0.1:8080，使应用端口只监听本机
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;  # 需大于 .env 中的 AI_TIMEOUT（本地模型生成行程可能要几分钟）
    }
}
